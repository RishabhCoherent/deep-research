# API Keys
# OpenAI is the default provider during debug (all tiers → gpt-4o-mini).
OPENAI_API_KEY=your_openai_api_key_here
# Only required if you flip LLM_PROVIDER back to "anthropic".
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM provider: "openai" (default, debug) or "anthropic"
LLM_PROVIDER=openai

# OpenAI model names — all set to gpt-4o-mini for cheap debug runs.
# Restore OPENAI_SONNET_MODEL=gpt-4o (and OPUS) once architecture is stable.
OPENAI_HAIKU_MODEL=gpt-4o-mini
OPENAI_SONNET_MODEL=gpt-4o-mini
OPENAI_OPUS_MODEL=gpt-4o-mini

# Search backend - SearXNG (primary, free)
# Start with: docker-compose up -d  (from repo root)
# SearXNG runs on http://localhost:8888 by default
SEARXNG_URL=http://localhost:8888

# Search backend - Tavily (optional paid fallback)
# Only needed if SearXNG is unavailable. Leave blank to rely on SearXNG only.
TAVILY_API_KEY=
TAVILY_API_KEY_2=
TAVILY_API_KEY_3=

# Optional - LangSmith tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=multi-agent-research

# Model Configuration
DEFAULT_MODEL=claude-3-haiku-20240307
SONNET_MODEL=claude-3-sonnet-20240229
OPUS_MODEL=claude-3-opus-20240229

# Budget Configuration
DEFAULT_BUDGET_USD=3.0
MAX_BUDGET_USD=5.0

# Search Configuration
TAVILY_MAX_RESULTS=10
TAVILY_NEWS_DAYS=90

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_DIR=~/.research/cache

# Development
DEBUG=false
